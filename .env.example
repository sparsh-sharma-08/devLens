# ============================================================
# DevLens AI — Environment Variables Template
# Copy this to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=devlens
POSTGRES_PASSWORD=devlens_secret
POSTGRES_DB=devlens
DATABASE_URL=postgresql+asyncpg://devlens:devlens_secret@postgres:5432/devlens

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- GitHub OAuth ---
# Register at: https://github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- Google OAuth (optional, Sprint 1 Should-have) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- JWT ---
JWT_SECRET_KEY=change_me_to_a_long_random_string_please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Provider (default: groq) ---
# Options: groq | claude | openai | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key        # https://console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile

# Claude fallback (optional)
ANTHROPIC_API_KEY=

# OpenAI fallback (optional)
OPENAI_API_KEY=

# Ollama fallback (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Embeddings ---
# Options: local | groq | voyage
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2       # used when EMBEDDING_PROVIDER=local

# --- Repository Processing ---
MAX_REPO_SIZE_MB=500
MAX_REPO_LOC=50000
CLONE_WORKSPACE_DIR=/tmp/devlens_repos

# --- App Settings ---
ENVIRONMENT=development                 # development | production
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Sentry (optional) ---
SENTRY_DSN=

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
